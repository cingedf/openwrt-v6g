# Qihoo 360 V6G (qihoo_360v6g) sparse seed config
# Official upstream OpenWrt v25.12.5; ramips/mt7621; 128 MiB NAND.
# Required role: PPPoE WAN + dual-band AP + SSH + LuCI + ShellCrash runtime environment.
# Deliberately sparse, following cingedf/openwrt-rm2100-ipv4: `make defconfig` resolves
# target dependencies and defaults; only deliberate choices and ShellCrash requirements
# are spelled out below.

CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_qihoo_360v6g=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_CCACHE=y

# --- Wi-Fi: MT7915 on PCIe. kmod-mt7915-firmware depends on kmod-mt7915e,
#     so the driver and the PCIe firmware blobs arrive together. ---
CONFIG_PACKAGE_kmod-mt7915-firmware=y
CONFIG_PACKAGE_wpad-basic-mbedtls=y

# --- USB 3.0 host controller (xHCI) ---
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-storage=y

# --- LuCI web UI: the meta package pulls luci-base, luci-mod-admin-full,
#     luci-theme-bootstrap, rpcd and uhttpd. No extra LuCI applications. ---
CONFIG_PACKAGE_luci=y

# --- IPv4/IPv6 networking userland ---
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_dnsmasq_full_dhcp=y
# ShellCrash DNS-based fake-ip/real-ip splitting needs dnsmasq nftset support.
CONFIG_PACKAGE_dnsmasq_full_nftset=y
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_nftables-json=y
CONFIG_PACKAGE_kmod-nft-core=y
CONFIG_PACKAGE_kmod-nft-nat=y
CONFIG_PACKAGE_kmod-nft-socket=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-nf-conntrack=y
CONFIG_PACKAGE_kmod-nf-nat=y
CONFIG_PACKAGE_kmod-nf-tproxy=y
CONFIG_PACKAGE_ip-tiny=y
CONFIG_PACKAGE_dropbear=y
CONFIG_DROPBEAR_SCP=y

# --- PPPoE WAN ---
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y
CONFIG_PACKAGE_kmod-ppp=y
CONFIG_PACKAGE_kmod-pppoe=y
CONFIG_PACKAGE_kmod-pppox=y
CONFIG_PACKAGE_kmod-slhc=y

# --- ShellCrash runtime requirements ---
# curl + CA bundle for install/update and subscription download; kmod-tun for TUN mode.
# BusyBox crond/crontab and the swap applets are already enabled by the shipped
# busybox defaults (CONFIG_BUSYBOX_DEFAULT_CROND / _CRONTAB / _SWAPON), so they must
# not be re-declared here: CONFIG_BUSYBOX_CONFIG_* only exists when BUSYBOX_CUSTOM=y.
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_kmod-tun=y

# --- ZRAM: compressed swap, useful when the proxy core and kernel compete for RAM ---
CONFIG_PACKAGE_kmod-zram=y
CONFIG_PACKAGE_zram-swap=y

# --- Deliberately not included (rm2100 parity): htop, tcpdump, iperf3, bash, nano,
#     ddns-scripts, irqbalance, openssh-sftp-server, ip-full. Add them at runtime
#     only when a concrete need appears.
# Do not patch CPU PLL, IRQ affinity or HNAT/flow-offload code.

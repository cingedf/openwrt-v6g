#!/bin/sh /etc/rc.common
# mihomo-v6g: direct-drive CrashCore (Mihomo Meta) WITHOUT the ShellCrash shell framework.
# Avoids start.sh entirely (fork-storm source). procd-managed with respawn.
# Ports: mixed 7890 / redir 7892 / tproxy 7893 / dns :1053 / api 127.0.0.1:9999
START=99
USE_PROCD=1
NAME=mihomo-v6g
BIN=/etc/ShellCrash/CrashCore
CFGD=/etc/ShellCrash
CFGF=$CFGD/configs/config.yaml
NFTF=/etc/nftables-mihomo.nft

start_service() {
	[ -x "$BIN" ] || { logger -t mihomo-v6g "$BIN missing"; return 1; }
	[ -f "$CFGF" ] || { logger -t mihomo-v6g "config missing"; return 1; }
	# firewall plumbing (idempotent)
	nft delete table inet mihomo 2>/dev/null
	if [ -f "$NFTF" ]; then
		nft -f "$NFTF" || { logger -t mihomo-v6g "nft load failed"; return 1; }
	fi
	ip rule del fwmark 1 table 100 2>/dev/null
	ip rule add fwmark 1 table 100
	ip route del local 0.0.0.0/0 table 100 2>/dev/null
	ip route add local 0.0.0.0/0 dev lo table 100
	procd_open_instance
	procd_set_param command "$BIN" -d "$CFGD" -f "$CFGF"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
	logger -t mihomo-v6g "started (direct-drive)"
}

stop_service() {
	nft delete table inet mihomo 2>/dev/null
	ip rule del fwmark 1 table 100 2>/dev/null
	ip route del local 0.0.0.0/0 table 100 2>/dev/null
	logger -t mihomo-v6g "stopped, tproxy plumbing removed"
}

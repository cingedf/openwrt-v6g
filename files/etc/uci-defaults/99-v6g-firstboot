#!/bin/sh
# Qihoo 360 V6G (qihoo_360t6gs) first-boot defaults

# LAN IP keeps continuity with the RAM-initramfs session (192.168.123.1)
uci set network.lan.ipaddr='192.168.123.1'
uci set network.lan.netmask='255.255.255.0'

# V6G physical ports: exactly two LAN ports in br-lan (switch port1/port2), WAN on switch port3
if [ -n "$(uci -q get network.@device[0])" ]; then
	uci -q del network.@device[0].ports
	uci add_list network.@device[0].ports='lan1'
	uci add_list network.@device[0].ports='lan2'
fi

# WAN device from DTS label
if [ -n "$(uci -q get network.wan)" ]; then
	uci set network.wan.device='wan'
fi

uci commit network

# Status LED service (official manual semantics: green solid = internet OK,
# red solid = no internet; boot/upgrade blinking handled by diag.sh aliases)
for f in /etc/init.d/v6g-led /usr/sbin/v6g-led-daemon; do
	[ -f "$f" ] && chmod 755 "$f"
done
/etc/init.d/v6g-led enable 2>/dev/null
/etc/init.d/v6g-led start 2>/dev/null

# Wireless defaults: radios are generated by wifi-detect once the MT7915
# PCIe device is probed. Enable both bands with the user's SSIDs as open
# networks -- set the WPA2 key in LuCI after first login.
if ! grep -q "config wifi-device" /etc/config/wireless 2>/dev/null; then
	/sbin/wifi config >/dev/null 2>&1 || true
fi
if grep -q "config wifi-device" /etc/config/wireless 2>/dev/null; then
	uci -q set wireless.radio0.disabled='0'
	uci -q set wireless.radio0.country='CN'
	uci -q set wireless.radio1.disabled='0'
	uci -q set wireless.radio1.country='CN'
	for s in $(uci -q show wireless | sed -n "s/^wireless\.\([^.]*\)\.device='radio0'$/\1/p"); do
		uci -q set wireless.$s.ssid='Redmi_579E_2.4'
		uci -q set wireless.$s.encryption='none'
		uci -q set wireless.$s.disabled='0'
	done
	for s in $(uci -q show wireless | sed -n "s/^wireless\.\([^.]*\)\.device='radio1'$/\1/p"); do
		uci -q set wireless.$s.ssid='Redmi_579E'
		uci -q set wireless.$s.encryption='none'
		uci -q set wireless.$s.disabled='0'
	done
	uci commit wireless
fi

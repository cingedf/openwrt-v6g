#!/bin/sh
# Qihoo 360 V6G (qihoo_360v6g) first-boot defaults

# LAN IP keeps continuity with the RAM-initramfs session (192.168.123.1)
uci set network.lan.ipaddr='192.168.123.1'
uci set network.lan.netmask='255.255.255.0'

# V6G physical ports: exactly two LAN jacks in br-lan (switch port0/port1), WAN on switch port3
if [ -n "$(uci -q get network.@device[0])" ]; then
	uci -q del network.@device[0].ports
	uci add_list network.@device[0].ports='lan1'
	uci add_list network.@device[0].ports='lan2'
fi

# WAN device from DTS label
if [ -n "$(uci -q get network.wan)" ]; then
	uci set network.wan.device='wan'
fi

# IPv6 is deliberately off at base: the proxy layer is IPv4-only, and any future
# v6 prefix would leak around the mihomo tproxy path. Remove the stock wan6 stub.
uci -q delete network.wan6

uci commit network

# ShellCrash uses nftables TProxy. Hardware/software flow offloading bypasses the
# nftables forward path, so both must stay off or proxied traffic leaks unproxied.
uci -q set firewall.@defaults[0].flow_offloading='0'
uci -q set firewall.@defaults[0].flow_offloading_hw='0'
uci commit firewall

# ZRAM is compressed swap, not extra physical RAM: no memory is used until swap
# pages are written. Conservative LZO algorithm, high swap priority.
uci -q set system.@system[0].zram_size_mb='64'
uci -q set system.@system[0].zram_comp_algo='lzo'
uci -q set system.@system[0].zram_priority='100'

# Time from CN NTP servers: pool.ntp.org is unreliable in CN and REALITY
# handshakes need a sane clock (livelock seen on first bring-up).
uci -q del system.@system[0].ntp_server
uci -q add_list system.@system[0].ntp_server='223.5.5.5'
uci -q add_list system.@system[0].ntp_server='cn.pool.ntp.org'

uci commit system
[ -x /etc/init.d/zram ] && /etc/init.d/zram enable

# Root password "password", pre-hashed here because the image has no chpasswd
# (CHPASSWD is off in the shipped busybox defaults). The Wi-Fi is open, so change
# this in LuCI/SSH immediately after the first boot.
ROOT_HASH='$6$vHb.WkW/PuYgn6sC$xTety3Gu990NoQQiOoRYpvvecUThDHa4S0AZfXZtIxzQ5JannoInmWUlNmzLUg/PzulsPnheixu87xKl0ebVX1'
if [ -f /etc/shadow ]; then
	sed -i "s|^root:[^:]*:|root:${ROOT_HASH}:|" /etc/shadow
else
	printf '%s\n' "root:${ROOT_HASH}:0:0:99999:7:::" >> /etc/shadow
fi

# Status LED service (official manual semantics: green solid = internet OK,
# red solid = no internet; boot/upgrade blinking handled by diag.sh aliases)
for f in /etc/init.d/v6g-led /usr/sbin/v6g-led-daemon; do
	[ -f "$f" ] && chmod 755 "$f"
done
/etc/init.d/v6g-led enable 2>/dev/null
/etc/init.d/v6g-led start 2>/dev/null

# Wireless defaults: radios are generated by wifi-detect once the MT7915
# PCIe device is probed. Enable both bands with the user's SSIDs as open
# networks -- set the WPA2 key in LuCI after first login.
if ! grep -q "config wifi-device" /etc/config/wireless 2>/dev/null; then
	/sbin/wifi config >/dev/null 2>&1 || true
fi
if grep -q "config wifi-device" /etc/config/wireless 2>/dev/null; then
	uci -q set wireless.radio0.disabled='0'
	uci -q set wireless.radio0.country='CN'
	uci -q set wireless.radio1.disabled='0'
	uci -q set wireless.radio1.country='CN'
	for s in $(uci -q show wireless | sed -n "s/^wireless\.\([^.]*\)\.device='radio0'$/\1/p"); do
		uci -q set wireless.$s.ssid='Redmi_579E_2.4'
		uci -q set wireless.$s.encryption='none'
		uci -q set wireless.$s.disabled='0'
	done
	for s in $(uci -q show wireless | sed -n "s/^wireless\.\([^.]*\)\.device='radio1'$/\1/p"); do
		uci -q set wireless.$s.ssid='Redmi_579E'
		uci -q set wireless.$s.encryption='none'
		uci -q set wireless.$s.disabled='0'
	done
	uci commit wireless
fi

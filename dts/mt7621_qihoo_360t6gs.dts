#include "mt7621.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>

/ {
	compatible = "qihoo,360t6gs", "mediatek,mt7621-soc";
	model = "Qihoo 360 V6G";

	aliases {
		/* Official LED semantics (LYQV6G manual):
		 * red blinking = booting / upgrading
		 * red solid    = no internet access
		 * green solid  = internet access OK (switched by v6g-led service)
		 */
		led-boot = &led_sys_red;
		led-failsafe = &led_sys_red;
		led-running = &led_sys_red;
		led-upgrade = &led_sys_red;
	};

	chosen {
		bootargs = "console=ttyS0,115200";
	};

	leds {
		compatible = "gpio-leds";

		led_sys_red: led-red {
			label = "red:sys";
			gpios = <&gpio 13 GPIO_ACTIVE_LOW>;
		};

		led_sys_green: led-green {
			label = "green:sys";
			gpios = <&gpio 15 GPIO_ACTIVE_LOW>;
		};

		led_sys_blue: led-blue {
			label = "blue:sys";
			gpios = <&gpio 16 GPIO_ACTIVE_LOW>;
		};
	};

	keys {
		compatible = "gpio-keys-polled";

		poll-interval = <20>;

		reset {
			label = "reset";
			linux,code = <KEY_RESTART>;
			gpios = <&gpio 7 GPIO_ACTIVE_LOW>;
		};

		colink {
			label = "colink";
			linux,code = <KEY_WPS_BUTTON>;
			gpios = <&gpio 6 GPIO_ACTIVE_LOW>;
		};
	};
};

&nand {
	status = "okay";

	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		partition@0 {
			label = "u-boot";
			reg = <0x0 0x80000>;
			read-only;
		};

		partition@80000 {
			label = "u-boot-env";
			reg = <0x80000 0x40000>;
		};

		partition@c0000 {
			label = "factory";
			reg = <0xc0000 0x40000>;
			read-only;

			nvmem-layout {
				compatible = "fixed-layout";
				#address-cells = <1>;
				#size-cells = <1>;

				eeprom_factory_0: eeprom@0 {
					reg = <0x0 0xe00>;
				};
			};
		};

		/* Stock bootloader-era data partitions (Config, config, factory2,
		 * plugin 36MiB, log 4MiB) merged into one bare 41MiB "storage"
		 * block, deliberately NOT mounted by OpenWrt. Opened up for future
		 * use: manual jffs2 / kernel-copy target, or a second factory
		 * image. Everything stock-only is gone; the layout after 0x2a00000
		 * is V6G OpenWrt owned end-to-end. */
		partition@100000 {
			label = "storage";
			reg = <0x100000 0x2900000>;
		};

		/* firmware spans straight to the end of the 128MiB flash. The
		 * kernel child stays at absolute offset 0x2a00000, which is
		 * DragonBluep U-Boot's built-in CONFIG_DEFAULT_NAND_KERNEL_OFFSET,
		 * so every boot path (mtkautoboot + web failsafe + TFTP recovery)
		 * keeps working byte-for-byte. The ubi child grows to 82MiB and
		 * rootfs_data autoresize turns that into ~75MiB writable overlay. */
		firmware: partition@2a00000 {
			label = "firmware";
			reg = <0x2a00000 0x5600000>;

			compatible = "fixed-partitions";
			partition@0 {
				label = "kernel";
				reg = <0x0 0x400000>;
			};

			partition@400000 {
				label = "ubi";
				reg = <0x400000 0x5200000>;
			};
		};
	};
};

&state_default {
	gpio {
		groups = "jtag", "uart3", "wdt";
		function = "gpio";
	};
};

&xhci {
	status = "okay";
};

&gmac0 {
	status = "okay";
};

&switch0 {
	status = "okay";

	/* Measured on the real V6G (RAM image, cable moved jack by jack):
	 *   the two LAN jacks are switch port1 and port2, the WAN jack is port3.
	 *   port1 = lan1, port2 = lan2, port3 = wan; port0 and port4 are not wired
	 *   (port0/port4 belong to the 360T6GS portmap "lllwl" which shares this
	 *   SoC, the V6G chassis only has three jacks). */
	ports {
		port@0 {
			status = "disabled";
		};

		port@1 {
			status = "okay";
			label = "lan1";
		};

		port@2 {
			status = "okay";
			label = "lan2";
		};

		port@3 {
			status = "okay";
			label = "wan";
		};
	};
};

&ethphy3 {
	/delete-property/ interrupts;
};

&pcie {
	/* mt7621.dtsi ships this controller disabled, so the MT7915 on the bus
	 * was never enumerated in round 7. The dtsi already carries
	 *	pinctrl-0 = <&pcie_pins>;  (group "pcie" muxed to gpio)
	 *	reset-gpios = <&gpio 19 GPIO_ACTIVE_LOW>;
	 * which matches the stock V6G DTB, so only the status needs flipping. */
	status = "okay";
};

&pcie1 {
	wifi@0,0 {
		compatible = "mediatek,mt76";
		reg = <0x0000 0 0 0 0>;
		nvmem-cells = <&eeprom_factory_0>;
		nvmem-cell-names = "eeprom";
		mediatek,disable-radar-background;
	};
};

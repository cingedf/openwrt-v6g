#include "mt7621.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

/ {
	compatible = "qihoo,360t6gs", "mediatek,mt7621-soc";
	model = "Qihoo 360 V6G";

	aliases {
		led-boot = &led_sys_red;
		led-failsafe = &led_sys_red;
		led-running = &led_sys_green;
		led-upgrade = &led_sys_green;
	};

	chosen {
		bootargs = "console=ttyS0,115200";
	};

	leds {
		compatible = "gpio-leds";

		led_sys_red: led-red {
			label = "red:sys";
			gpios = <&gpio 13 GPIO_ACTIVE_LOW>;
		};

		led_sys_green: led-green {
			label = "green:sys";
			gpios = <&gpio 15 GPIO_ACTIVE_LOW>;
		};

		led_sys_blue: led-blue {
			label = "blue:sys";
			gpios = <&gpio 10 GPIO_ACTIVE_LOW>;
		};
	};

	keys {
		compatible = "gpio-keys-polled";

		poll-interval = <20>;

		reset {
			label = "reset";
			linux,code = <KEY_RESTART>;
			gpios = <&gpio 7 GPIO_ACTIVE_LOW>;
		};

		mesh {
			label = "mesh";
			linux,code = <KEY_WPS_BUTTON>;
			gpios = <&gpio 6 GPIO_ACTIVE_LOW>;
		};
	};
};

&nand {
	status = "okay";

	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		partition@0 {
			label = "u-boot";
			reg = <0x0 0x80000>;
			read-only;
		};

		partition@80000 {
			label = "u-boot-env";
			reg = <0x80000 0x40000>;
		};

		partition@C0000 {
			label = "factory";
			reg = <0xC0000 0x40000>;
			read-only;

			nvmem-layout {
				compatible = "fixed-layout";
				#address-cells = <1>;
				#size-cells = <1>;

				eeprom_factory_0: eeprom@0 {
					reg = <0x0 0xe00>;
				};

				macaddr_factory_3fff4: macaddr@3fff4 {
					reg = <0x3fff4 0x6>;
				};

				macaddr_factory_3fffa: macaddr@3fffa {
					reg = <0x3fffa 0x6>;
				};
			};
		};

		partition@100000 {
			label = "config";
			reg = <0x100000 0x40000>;
		};

		partition@140000 {
			label = "config0";
			reg = <0x140000 0x40000>;
		};

		partition@180000 {
			label = "plugin";
			reg = <0x180000 0x2400000>;
		};

		partition@2580000 {
			label = "log";
			reg = <0x2580000 0x400000>;
		};

		firmware: partition@2a00000 {
			label = "firmware";
			reg = <0x2a00000 0x5600000>;
		};
	};
};

&state_default {
	gpio {
		groups = "jtag", "uart3", "wdt";
		function = "gpio";
	};
};

&xhci {
	status = "okay";
};



&gmac0 {
	status = "okay";
	nvmem-cells = <&macaddr_factory_3fff4>;
	nvmem-cell-names = "mac-address";
};

&switch0 {
	status = "okay";

	ports {
		port@0 {
			status = "okay";
			label = "lan1";
		};

		port@1 {
			status = "okay";
			label = "lan2";
		};

		port@2 {
			status = "okay";
			label = "lan3";
		};
	};
};

&gmac1 {
	status = "okay";
	label = "wan";
	phy-handle = <&ethphy3>;
	nvmem-cells = <&macaddr_factory_3fffa>;
	nvmem-cell-names = "mac-address";
};

&ethphy3 {
	/delete-property/ interrupts;
};

&pcie1 {
	wifi@0,0 {
		compatible = "mediatek,mt76";
		reg = <0x0000 0 0 0 0>;
		nvmem-cells = <&eeprom_factory_0>;
		nvmem-cell-names = "eeprom";
		mediatek,disable-radar-background;
	};
};
